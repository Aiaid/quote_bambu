# Copy to .env and fill in: cp .env.example .env

# --- P2S printer (LAN) ---
PRINTER_IP=192.168.1.50
PRINTER_SN=
PRINTER_ACCESS=

# --- Quote/0 device ---
QUOTE0_API_KEY=
QUOTE0_DEVICE_ID=

# --- Behavior ---
INTERVAL_SECONDS=60
SHOW_CAMERA=true
# Camera protocol. auto = probe port 322 first then fallback to JPEG/6000.
#   rtsps : P2S, X1 series, H2 series          (ffmpeg -> port 322)
#   jpeg  : P1P, P1S, A1, A1 mini              (raw TLS  -> port 6000)
CAMERA_PROTO=auto

# Quote/0 push transport.
#   canvas : Canvas API /device/<id>/canvas  — vector div/span/CSS layout,
#            device pixel fonts, sharper text (default)
#   image  : Image API  /device/<id>/image   — one flat PIL-rendered PNG
# Both render the same data. The canvas content block must be added to the
# device Loop task in the Dot. App (separate from the image block).
PUSH_MODE=canvas

# Comma-separated HMS ecodes (16-hex uppercase, no separator) to never
# full-screen as ALERT — for persistent / benign warnings you don't want
# blocking the normal layout. Example:
# HMS_IGNORE=0500060000020070
HMS_IGNORE=

# Timezone for header clock / HMS timestamps. Container defaults to UTC,
# so most users will want to override this. Any IANA name works.
TZ=Asia/Shanghai
